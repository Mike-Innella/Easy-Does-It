import React, { useEffect, useState } from "react";
import {
  SafeAreaView,
  View,
  Text,
  TextInput,
  Pressable,
  StyleSheet,
} from "react-native";

const MS_PER_DAY = 1000 * 60 * 60 * 24;

function parseDateString(value: string): Date | null {
  // Expecting "YYYY-MM-DD"
  const [yearStr, monthStr, dayStr] = value.split("-");
  const year = Number(yearStr);
  const month = Number(monthStr);
  const day = Number(dayStr);

  if (!year || !month || !day) return null;

  // Construct as local date to avoid timezone shifting issues
  const date = new Date(year, month - 1, day);

  // Guard against invalid dates like 2025-02-31
  if (
    date.getFullYear() !== year ||
    date.getMonth() !== month - 1 ||
    date.getDate() !== day
  ) {
    return null;
  }

  return date;
}

function getDaysSober(startDate: Date | null): number {
  if (!startDate) return 0;

  const today = new Date();

  const start = new Date(
    startDate.getFullYear(),
    startDate.getMonth(),
    startDate.getDate()
  );
  const end = new Date(today.getFullYear(), today.getMonth(), today.getDate());

  const diffMs = end.getTime() - start.getTime();
  if (diffMs < 0) return 0;

  // Inclusive count: sober day = day 1
  return Math.floor(diffMs / MS_PER_DAY) + 1;
}

export default function App() {
  const [inputDate, setInputDate] = useState<string>("");
  const [savedDate, setSavedDate] = useState<Date | null>(null);
  const [error, setError] = useState<string>("");

  const daysSober = getDaysSober(savedDate);

  useEffect(() => {
    // If you later add AsyncStorage, load saved date here.
    // For now this stays empty so it’s purely in-memory.
  }, []);

  const handleSaveDate = () => {
    setError("");

    const parsed = parseDateString(inputDate.trim());
    if (!parsed) {
      setError("Please enter a valid date in YYYY-MM-DD format.");
      setSavedDate(null);
      return;
    }

    setSavedDate(parsed);

    // Example for future persistence:
    // await AsyncStorage.setItem("soberDate", inputDate.trim());
  };

  const handleReset = () => {
    setInputDate("");
    setSavedDate(null);
    setError("");
    // And clear from storage later if you add it
    // await AsyncStorage.removeItem("soberDate");
  };

  return (
    <SafeAreaView style={styles.root}>
      <View style={styles.container}>
        <Text style={styles.title}>Sober Day Counter</Text>
        <Text style={styles.subtitle}>
          Track how many days you've been clean.
        </Text>

        <View style={styles.card}>
          <Text style={styles.label}>Sober since (YYYY-MM-DD)</Text>

          <TextInput
            style={styles.input}
            placeholder="2025-09-03"
            placeholderTextColor="#6b7280"
            value={inputDate}
            onChangeText={setInputDate}
            autoCapitalize="none"
            autoCorrect={false}
            keyboardType="numbers-and-punctuation"
          />

          {error ? <Text style={styles.errorText}>{error}</Text> : null}

          <Pressable style={styles.saveButton} onPress={handleSaveDate}>
            <Text style={styles.saveButtonText}>Save Date</Text>
          </Pressable>

          {savedDate && (
            <View style={styles.savedInfo}>
              <Text style={styles.savedLabel}>
                Saved date:{" "}
                <Text style={styles.savedValue}>
                  {savedDate.toDateString()}
                </Text>
              </Text>

              <Text style={styles.daysText}>
                <Text style={styles.daysNumber}>{daysSober}</Text> days sober
              </Text>
            </View>
          )}

          <Pressable
            style={[styles.saveButton, styles.resetButton]}
            onPress={handleReset}
          >
            <Text style={[styles.saveButtonText, styles.resetButtonText]}>
              Reset
            </Text>
          </Pressable>
        </View>
      </View>
    </SafeAreaView>
  );
}

